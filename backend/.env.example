PORT=4000
JWT_SECRET=dev-secret-change
AI_ENABLED=false
FRONTEND_URL=http://localhost:5173

# ---- AI chatbot (self-hosted local VM primary, hosted fallbacks) ----------
# The local VM endpoint runs first; on error/timeout we roll to OpenRouter,
# then Google AI Studio, then NVIDIA. Leave all keys empty to use the on-device
# assistant instead (POST /api/ai/chat).
AI_PROVIDER=local                 # local | openrouter | google | nvidia
AI_FALLBACK_ORDER=local,openrouter,google,nvidia
# Self-hosted OpenAI-compatible server — paste your link here. Works with a
# Cloudflare Tunnel link as-is; "/v1" is appended if you leave the path off.
#   e.g. https://random-words.trycloudflare.com   (bare link is fine)
#        http://my-vm:11434/v1 / http://my-vm:8000/v1
LOCAL_AI_BASE_URL=
LOCAL_AI_MODEL=                   # model id your VM serves (default: local-model)
LOCAL_AI_API_KEY=                 # only if your server requires a key
# CF_ACCESS_CLIENT_ID=            # only if the tunnel is behind Cloudflare Access
# CF_ACCESS_CLIENT_SECRET=
OPENROUTER_API_KEY=               # https://openrouter.ai/keys
GEMINI_API_KEY=                   # https://aistudio.google.com/apikey  (Google AI Studio)
NVIDIA_API_KEY=                   # https://build.nvidia.com/settings/api-keys
AI_MODEL_OPENROUTER=poolside/laguna-xs-2.1:free   # any OpenRouter model id
AI_MODEL_GOOGLE=gemini-3.8-flash
# AI_MODEL_NVIDIA=meta/llama-3.3-70b-instruct
# AI_BASE_URL=                   # optional base URL override for the primary provider
# AI_API_KEY=your-key-here       # shared key for any non-local provider
# OPENROUTER_SITE_URL=http://localhost:5173

# ---- Database: sqlite (default) or mysql ----
DB_DIALECT=sqlite
SQLITE_FILE=./data/slotsync.sqlite

# MySQL local (used when DB_DIALECT=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=changeme
MYSQL_DATABASE=slotsync
# TLS (managed MySQL / TiDB Cloud). Default = TLS on; set MYSQL_CA to verify.
# MYSQL_SSL=require
# MYSQL_CA=./certs/ca.pem

# ---- TiDB Cloud (serverless MySQL) — used by `npm run tidb:setup` ----
# Copy these from the TiDB Cloud console (Connect → MySQL client).
TIDB_HOST=gateway01.<region>.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=<prefix>.root
TIDB_PASSWORD=
TIDB_DATABASE=slotsync
# TIDB_CA=./certs/ca.pem        # optional — verify TLS with the TiDB Cloud CA
# TIDB_SSL=require              # require (default) | disable
